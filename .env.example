# =========================
# Frontend
# =========================

# Browser에서 접근하는 Backend API 주소
VITE_API_BASE_URL=http://localhost:8000


# =========================
# Backend
# =========================

# FastAPI 실행 포트
BACKEND_PORT=8000

# Vite 개발 서버 포트
FRONTEND_PORT=5173

# SQLite Database URL
# Docker Compose 환경에서는 /data/app.db 경로를 사용한다.
DATABASE_URL=sqlite:////data/app.db


# =========================
# Development
# =========================

# 개발 환경 구분
APP_ENV=development